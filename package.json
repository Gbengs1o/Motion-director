{
  "name": "motion-director-app",
  "version": "1.0.0",
  "description": "Motion Director Standalone Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k \"npm run build:css -- --watch\" \"electron .\"",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/output.css",
    "build": "npm run build:css && electron-builder",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.18.2",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.0.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "timecut": "^0.3.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  },
  "build": {
    "appId": "com.motiondirector.app",
    "productName": "Motion Director",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "index.html",
      "renderer.js"
    ]
  }
}